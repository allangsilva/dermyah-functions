# Copy this to app.yaml (gitignored) and fill in real values before deploying locally.
# In CI, this template is rendered into app.yaml via `envsubst`, pulling secret values
# from GCP Secret Manager at deploy time (see .github/workflows/deploy.yml).

# [START gae_quickstart_yaml]
runtime: nodejs24
# [END gae_quickstart_yaml]

# Explicit, since `npm start` now boots local-dev-only tooling (docker compose for
# Mongo) that doesn't exist in the App Engine sandbox. Don't rely on the npm-start
# default here.
entrypoint: node src/app.js

env_variables:
  MONGO_URL: ${MONGO_URL}
  JWT_SECRET: ${JWT_SECRET}
  JWT_EXPIRES_IN: 7d
  ADMIN_KEY: ${ADMIN_KEY}

  # possible deprecated
  GCS_BUCKET: gs://dermyah
  GCLOUD_PROJECT: dermyah
  GCS_KEYFILE: firebaseServiceAccount.json

  INFRA_KEY: ${INFRA_KEY}
  GOOGLE_CLOUD_PROJECT: dermyah
  GCLOUD_STORAGE_BUCKET: gs://dermyah
  GOOGLE_APPLICATION_CREDENTIALS: firebaseServiceAccount.json
  GOOGLE_GENAI_USE_ENTERPRISE: "true"
  GOOGLE_CLOUD_LOCATION: us-central1
